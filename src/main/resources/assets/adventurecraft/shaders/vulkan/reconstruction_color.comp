#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D sourceColor;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D targetColor;
layout(push_constant) uniform ColorConversion { uint encodeDisplay; } conversion;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy), extent = imageSize(targetColor);
    if (any(greaterThanEqual(pixel,extent))) return;
    vec4 value = texelFetch(sourceColor,pixel,0);
    vec3 color = max(value.rgb,vec3(0.0));
    if (conversion.encodeDisplay!=0u) color = mix(1.055*pow(color,vec3(1.0/2.4))-0.055,color*12.92,
        lessThanEqual(color,vec3(0.0031308)));
    else color = mix(pow((color+0.055)/1.055,vec3(2.4)),color/12.92,lessThanEqual(color,vec3(0.04045)));
    imageStore(targetColor,pixel,vec4(color,value.a));
}
