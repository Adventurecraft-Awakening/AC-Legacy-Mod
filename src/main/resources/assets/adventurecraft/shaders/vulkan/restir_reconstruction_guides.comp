#version 460
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#include "restir_gbuffer.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D inputs[4];
layout(set = 0, binding = 1, r32f) uniform writeonly image2D viewDepth;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D motion;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D normalRoughness;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D diffuseAlbedo;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D specularAlbedo;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D diffuseRadiance;
layout(set = 0, binding = 7, rgba16f) uniform writeonly image2D specularRadiance;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D indirectRadiance;
layout(set = 0, binding = 9, rgba8) uniform writeonly image2D reactive;
layout(set = 0, binding = 11, r32f) uniform writeonly image2D specularHitDistance;
#include "reconstruction_parameters.glsl"
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer ReconstructionRadiance { vec4 values[]; };
layout(push_constant, std430) uniform ReconstructionPush {
    uint64_t diffuseAddress;
    uint64_t specularAddress;
    uint64_t indirectAddress;
} sources;

vec4 cleanSignal(vec4 value) {
    return any(isnan(value)) || any(isinf(value)) ? vec4(0.0) : clamp(value,vec4(0.0),vec4(65504.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel,ivec2(reconstruction.dimensions.xy)))) return;
    vec4 position = texelFetch(inputs[0],pixel,0);
    uint flags = uint(round(max(position.w,0.0)));
    bool valid = (flags&RESTIR_VALID)!=0u && !any(isnan(position.xyz)) && !any(isinf(position.xyz));
    uint index = uint(pixel.y)*reconstruction.dimensions.x+uint(pixel.x);
    vec4 normal = texelFetch(inputs[1],pixel,0);
    vec4 albedo = texelFetch(inputs[2],pixel,0);
    vec4 specular = texelFetch(inputs[3],pixel,0);
    vec3 diffuseFactor = valid ? max(albedo.rgb,vec3(0.0))*(1.0-clamp(albedo.a,0.0,1.0)) : vec3(0.0);
    // The producer divides by this same bounded F0, so remodulation is exact,
    // including black conductor texels and very small authored reflectance.
    vec3 specularFactor = valid ? max(specular.rgb,vec3(0.02)) : vec3(0.0);
    imageStore(normalRoughness,pixel,vec4(valid ? restirOctDecode(normal.xy) : vec3(0,0,1),
        valid ? clamp(specular.a,0.02,1.0) : 1.0));
    imageStore(diffuseAlbedo,pixel,vec4(diffuseFactor,valid ? 1.0 : 0.0));
    imageStore(specularAlbedo,pixel,vec4(specularFactor,valid ? 1.0 : 0.0));
    imageStore(viewDepth,pixel,vec4(valid ? abs((reconstruction.worldToView*vec4(position.xyz,1)).z) : 1000000.0));
    vec2 uv = (vec2(pixel)+0.5)/vec2(reconstruction.dimensions.xy);
    imageStore(motion,pixel,vec4(valid ? reconstructionMotion(position.xyz,uv,false) : vec2(0.0),0,0));
    imageStore(reactive,pixel,vec4(0.0));
    imageStore(diffuseRadiance,pixel,valid && sources.diffuseAddress!=uint64_t(0)
        ? cleanSignal(ReconstructionRadiance(sources.diffuseAddress).values[index]) : vec4(0));
    vec4 specularSignal = valid && sources.specularAddress!=uint64_t(0)
        ? cleanSignal(ReconstructionRadiance(sources.specularAddress).values[index]) : vec4(0);
    imageStore(specularRadiance,pixel,specularSignal);
    imageStore(specularHitDistance,pixel,vec4(specularSignal.w));
    imageStore(indirectRadiance,pixel,valid && sources.indirectAddress!=uint64_t(0)
        ? cleanSignal(ReconstructionRadiance(sources.indirectAddress).values[index]) : vec4(0));
}
