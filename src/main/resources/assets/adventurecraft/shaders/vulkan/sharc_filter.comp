#version 460
#include "sharc_screen.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (!sharcInBounds(pixel)) return;
    SharcFrameParameters p = SharcFrameParameters(sharcPush.parameters);
    uint index = sharcPixelIndex(pixel);
    SharcScreenSurface surface = sharcScreenSurface(pixel,false);
    SharcRadianceBuffer raw = SharcRadianceBuffer(p.rawGI);
    vec4 result = vec4(0.0);
    if (surface.valid && raw.values[index].a>0.0) {
        vec3 sum = vec3(0.0), squares = vec3(0.0), upper = vec3(0.0), lower = vec3(1e30);
        float weightSum = 0.0;
        int radius = int(clamp(p.quality.y,1u,2u));
        for (int y=-radius;y<=radius;y++) for (int x=-radius;x<=radius;x++) {
            ivec2 neighbor = pixel+ivec2(x,y);
            if (!sharcInBounds(neighbor)) continue;
            SharcScreenSurface other = sharcScreenSurface(neighbor,false);
            if (!sharcCompatible(surface,other)) continue;
            vec4 value = raw.values[sharcPixelIndex(neighbor)];
            if (value.a<=0.0) continue;
            vec3 radiance = max(value.rgb,vec3(0.0));
            int horizontal = radius==1 ? (x==0 ? 2 : 1) : (x==0 ? 6 : abs(x)==1 ? 4 : 1);
            int vertical = radius==1 ? (y==0 ? 2 : 1) : (y==0 ? 6 : abs(y)==1 ? 4 : 1);
            float weight = float(horizontal*vertical)
                *pow(max(dot(surface.normal,other.normal),0.0),32.0);
            sum += radiance*weight;
            squares += radiance*radiance*weight;
            upper = max(upper,radiance);
            lower = min(lower,radiance);
            weightSum += weight;
        }
        vec3 current = weightSum>0.0 ? sum/weightSum : max(raw.values[index].rgb,vec3(0.0));
        vec3 variance = weightSum>0.0 ? max(squares/weightSum-current*current,vec3(0.0)) : vec3(0.0);
        float historyLength = 1.0;
        vec2 previousUv;
        // Resolve stochastic irradiance before final image TAA. Coverage history
        // and its color clipping cannot replace a lighting history on detailed
        // albedo textures, particularly while the camera moves.
        if (p.control.w==0u && p.previousFilteredGI!=uint64_t(0)
            && any(greaterThan(upper,vec3(0.000001))) && sharcDenoiseReproject(surface,previousUv)) {
            vec2 historyPixel = previousUv*vec2(p.dimensions.xy)-0.5;
            ivec2 base = ivec2(floor(historyPixel));
            vec2 fraction = fract(historyPixel);
            vec4 history = vec4(0.0);
            float historyWeight = 0.0;
            for (int y=0;y<2;y++) for (int x=0;x<2;x++) {
                ivec2 previous = base+ivec2(x,y);
                if (!sharcInBounds(previous)) continue;
                float weight = (x==0 ? 1.0-fraction.x : fraction.x)
                    *(y==0 ? 1.0-fraction.y : fraction.y);
                if (weight<=0.0) continue;
                SharcScreenSurface oldSurface = sharcScreenSurface(previous,true);
                oldSurface.position -= p.originDelta.xyz;
                if (!sharcCompatible(surface,oldSurface)) continue;
                vec4 value = SharcRadianceBuffer(p.previousFilteredGI).values[sharcPixelIndex(previous)];
                if (value.a<=0.0 || any(isnan(value)) || any(isinf(value))) continue;
                history += value*weight;
                historyWeight += weight;
            }
            if (historyWeight>0.0) {
                history /= historyWeight;
                vec3 sigma = sqrt(variance);
                vec3 clipped = clamp(history.rgb,max(vec3(0.0),lower-1.5*sigma),upper+1.5*sigma+vec3(0.00001));
                historyLength = min(history.a,15.0)+1.0;
                current = mix(clipped,current,1.0/historyLength);
            }
        }
        if (p.control.w==1u || p.control.w==2u) current = raw.values[index].rgb;
        else if (p.control.w==3u) current = vec3(historyLength/16.0,0.0,1.0-historyLength/16.0);
        result = vec4(current,historyLength);
    }
    SharcRadianceBuffer(p.filteredGI).values[index] = result;
}
