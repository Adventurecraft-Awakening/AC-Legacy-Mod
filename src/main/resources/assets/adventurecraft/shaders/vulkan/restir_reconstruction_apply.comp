#version 460
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D denoised[5];
layout(buffer_reference, std430, buffer_reference_align = 16) buffer ReconstructionResult { vec4 values[]; };
layout(push_constant, std430) uniform ApplyPush {
    uint64_t directAddress;
    uint64_t indirectAddress;
} outputs;
vec3 clean(vec3 value) { return any(isnan(value)) || any(isinf(value)) ? vec3(0.0) : clamp(value,vec3(0),vec3(65504)); }
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy), extent = textureSize(denoised[0],0);
    if (any(greaterThanEqual(pixel,extent))) return;
    uint index = uint(pixel.y)*uint(extent.x)+uint(pixel.x);
    vec4 diffuseFactor = texelFetch(denoised[3],pixel,0);
    vec3 specularFactor = texelFetch(denoised[4],pixel,0).rgb;
    bool valid = diffuseFactor.a>0.5;
    if (outputs.directAddress!=uint64_t(0)) {
        vec3 direct = clean(texelFetch(denoised[0],pixel,0).rgb)*diffuseFactor.rgb
            +clean(texelFetch(denoised[1],pixel,0).rgb)*specularFactor;
        ReconstructionResult(outputs.directAddress).values[index] = vec4(valid ? clean(direct) : vec3(0),valid ? 1.0 : 0.0);
    }
    if (outputs.indirectAddress!=uint64_t(0)) {
        ReconstructionResult(outputs.indirectAddress).values[index] = vec4(valid ? clean(texelFetch(denoised[2],pixel,0).rgb) : vec3(0),
            valid ? 1.0 : 0.0);
    }
}
